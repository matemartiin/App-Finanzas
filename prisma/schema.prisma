generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  type        TransactionType
  description String
  date        DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id])
  isRecurring Boolean  @default(false)
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id])
  tags        Tag[]
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([walletId])
  @@index([type])
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  icon         String
  color        String
  type         TransactionType
  isDefault    Boolean  @default(false)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime @default(now())
}

model Wallet {
  id           String   @id @default(cuid())
  name         String
  type         WalletType
  provider     String?
  balance      Decimal  @db.Decimal(12, 2) @default(0)
  currency     String   @default("ARS")
  isConnected  Boolean  @default(false)
  lastSync     DateTime?
  config       Json?
  transactions Transaction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Budget {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  spent       Decimal  @db.Decimal(12, 2) @default(0)
  period      BudgetPeriod
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([startDate, endDate])
}

model RecurringTransaction {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  type        TransactionType
  description String
  categoryId  String?
  frequency   Frequency
  nextDate    DateTime
  isActive    Boolean  @default(true)
  transactions Transaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        EventType
  amount      Decimal? @db.Decimal(12, 2)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Tag {
  id           String   @id @default(cuid())
  name         String   @unique
  transactions Transaction[]
  createdAt    DateTime @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum WalletType {
  DIGITAL_WALLET
  BANK
  CASH
  CRYPTO
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum EventType {
  PAYMENT_DUE
  INCOME
  REMINDER
  GOAL
}

// ===== Portfolio / Investments =====

model PortfolioHolding {
  id           String   @id @default(cuid())
  ticker       String           // "GGAL", "YPF", "MELI", "AL30", "GD30"
  name         String           // "Grupo Financiero Galicia"
  type         AssetType        // STOCK | BOND | CEDEAR | FCI
  quantity     Decimal  @db.Decimal(12, 4)
  avgCost      Decimal  @db.Decimal(12, 2)  // Precio promedio de compra
  currency     String   @default("ARS")
  sector       String?          // "Financiero", "Energía", "Tecnología"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketData {
  id           String   @id @default(cuid())
  ticker       String
  price        Decimal  @db.Decimal(12, 2)
  change       Decimal  @db.Decimal(8, 4)     // Daily change %
  volume       BigInt?
  high         Decimal? @db.Decimal(12, 2)
  low          Decimal? @db.Decimal(12, 2)
  updatedAt    DateTime @default(now())

  @@unique([ticker])
  @@index([ticker])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  type         String           // "oficial", "blue", "mep", "ccl", "cripto"
  buyPrice     Decimal  @db.Decimal(12, 2)
  sellPrice    Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @default(now())

  @@unique([type])
}

model NewsItem {
  id           String   @id @default(cuid())
  title        String
  summary      String?
  source       String           // "ambito", "cronista", "infobae"
  url          String
  ticker       String?          // Related ticker if any
  sector       String?          // Related sector
  impact       String?          // AI analysis of impact: "positive", "negative", "neutral"
  impactAnalysis String?        // AI-generated analysis text
  publishedAt  DateTime
  createdAt    DateTime @default(now())
}

enum AssetType {
  STOCK
  BOND
  CEDEAR
  FCI
}
